*.iml
.gradle/
.kotlin/
.idea/
build/
/local.properties
/captures
.externalNativeBuild
.cxx
*.apk
*.aab

# On-device model artifacts are large binaries — keep them out of git.
# Place them under app/src/main/assets/models/ locally (see ml/README.md).
app/src/main/assets/models/*.pte
app/src/main/assets/models/*.task
app/src/main/assets/models/*.bin
ml/.venv/
ml/out/
ml/data/*
!ml/data/*.md
__pycache__/
*.pyc

# Device-test evidence: keep the reports, not the screenshots, UI dumps or sample pulls.
tools/devtest*/*
!tools/devtest*/*.md
# Field pulls stay out of git; their README stays in.
!ml/data/field/
ml/data/field/*
!ml/data/field/*.md
